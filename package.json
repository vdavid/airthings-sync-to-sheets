{
  "name": "airthings-sync-to-sheets",
  "version": "1.0.0",
  "description": "To sync data from my Airthings View Plus to Google Sheets",
  "main": "Code.ts",
  "author": "David Veszelovszki",
  "license": "MIT",
  "private": false,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "push": "pnpm run build && clasp push -f",
    "deploy": "pnpm run build && clasp push -f && clasp deploy"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "pnpm": ">=11"
  },
  "devDependencies": {
    "@google/clasp": "^3.3.0",
    "@types/google-apps-script": "^2.0.11",
    "esbuild": "^0.28.1",
    "esbuild-gas-plugin": "^0.10.0",
    "typescript": "^6.0.3"
  }
}
